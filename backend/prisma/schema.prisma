// Schema do sistema de Controle de Producao e Perdas de Salgados
//
// Banco padrao: SQLite (zero configuracao, roda local sem instalar servidor).
// Para usar PostgreSQL em producao, troque o provider abaixo para "postgresql"
// e ajuste DATABASE_URL no .env (ex: postgresql://user:pass@host:5432/db).
// O restante do schema e do codigo funciona sem alteracoes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Produto {
  id            Int      @id @default(autoincrement())
  nome          String
  categoria     String?
  unidade       String   @default("un")
  custoUnitario Float
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  producoes Producao[]
  perdas    Perda[]

  @@index([ativo])
}

// Turnos de trabalho fixos (06:00-14:00 e 14:00-22:00), guardados em tabela
// para permitir consulta/edicao dos horarios sem alterar codigo.
model Turno {
  id         Int    @id @default(autoincrement())
  codigo     String @unique // "T1" | "T2"
  nome       String
  horaInicio String
  horaFim    String

  producoes Producao[]
  perdas    Perda[]
}

// Motivos de perda fixos (Caiu no chao, Azedou, Rachou, Duro, Nao vendeu).
model MotivoPerda {
  id     Int    @id @default(autoincrement())
  codigo String @unique
  nome   String
  ativo  Boolean @default(true)

  perdas Perda[]
}

model Producao {
  id         Int      @id @default(autoincrement())
  produtoId  Int
  produto    Produto  @relation(fields: [produtoId], references: [id])
  turnoId    Int
  turno      Turno    @relation(fields: [turnoId], references: [id])
  data       DateTime // data do lancamento (sem horario, meia-noite UTC)
  quantidade Int
  createdAt  DateTime @default(now())

  @@index([data])
  @@index([produtoId])
}

// Registro de perda. custoUnitarioHistorico e custoTotal sao um SNAPSHOT do
// custo do produto no momento do lancamento: mesmo que Produto.custoUnitario
// mude depois, este registro nunca muda de valor, garantindo relatorios
// financeiros auditaveis (regra critica do negocio).
model Perda {
  id         Int         @id @default(autoincrement())
  produtoId  Int
  produto    Produto     @relation(fields: [produtoId], references: [id])
  turnoId    Int
  turno      Turno       @relation(fields: [turnoId], references: [id])
  motivoId   Int
  motivo     MotivoPerda @relation(fields: [motivoId], references: [id])
  data       DateTime
  quantidade Int

  custoUnitarioHistorico Float
  custoTotal             Float

  createdAt DateTime @default(now())

  @@index([data])
  @@index([produtoId])
  @@index([motivoId])
}
