PORT=3333
CORS_ORIGIN="http://localhost:5173"

# Senha da área administrativa (login em /login). Troque em produção.
ADMIN_PASSWORD="troque-esta-senha"
# Segredo usado para assinar o token de sessão administrativa. Troque em produção.
JWT_SECRET="troque-este-segredo-tambem"

# Supabase — Settings → API no dashboard do projeto.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
# Chave "service_role" (NUNCA a "anon"/"publishable"): o backend é um
# servidor de confiança e precisa ignorar RLS. Nunca exponha esta chave ao
# frontend.
SUPABASE_SERVICE_ROLE_KEY="troque-por-sua-service-role-key"
